{
  "manifest_version": 3,
  "name": "Browser MCP",
  "version": "0.1.3",
  "description": "Lets your local Browser MCP server control a tab you connect.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["alarms", "debugger", "storage"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Browser MCP",
    "default_popup": "popup.html"
  }
}
